{
  "appId": "com.bhagvadgeeta.app",
  "appName": "Bhagvad Geeta",
  "webDir": "www",
  "server": {
    "allowNavigation": [
      "www.youtube.com",
      "youtube.com",
      "*.youtube.com",
      "*.ytimg.com",
      "*.googlevideo.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#FFF8E1",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true,
      "showSpinner": false
    }
  }
}
